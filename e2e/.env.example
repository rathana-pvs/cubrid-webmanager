# Copy this file to e2e/.env and fill in values before running E2E tests.
# Web tests require a running api-server + web-manager (npm run dev:stack or npm run start).

# App URL — built single server (default: https://localhost:8080)
# For Vite dev server use: http://localhost:5173
BASE_URL=https://localhost:8080

# Credentials for an existing user account
E2E_USERNAME=admin
E2E_PASSWORD=

# Real CUBRID Manager Server target used by both web and Electron.
E2E_HOST_ADDRESS=localhost
E2E_HOST_PORT=8001
E2E_HOST_USER=admin
E2E_HOST_PASSWORD=admin
E2E_HOST_ALIAS=E2E Test Host

# Existing database used by database, broker, and monitoring scenarios.
E2E_DB=demodb

# Dedicated database for offline operations. Optimize stops it if needed and
# restores its original running state afterward; do not use a production DB.
E2E_OFFLINE_DB=db1

# VPS / Remote Environment Cleanup (npm run e2e:clean:vps)
VPS_HOST=localhost
VPS_PORT=22
VPS_USER=cubrid
VPS_PASS=
# VPS_KEY=/path/to/id_rsa
# CUBRID_CONTAINER=cubrid-11.4

